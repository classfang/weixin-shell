{
  "name": "@fangjunjie/weixin-shell",
  "version": "0.1.0",
  "description": "通过微信 ClawBot 原生 iLink 通道执行本机 Shell 命令",
  "type": "module",
  "bin": { "weixin-shell": "src/cli.js" },
  "files": ["src/", "images/weixin-shell-logo.svg", ".env.example", "README_EN.md", "CONTRIBUTING.md", "SECURITY.md"],
  "repository": { "type": "git", "url": "git+https://github.com/classfang/weixin-shell.git" },
  "bugs": { "url": "https://github.com/classfang/weixin-shell/issues" },
  "homepage": "https://github.com/classfang/weixin-shell#readme",
  "author": "Junki",
  "license": "ISC",
  "keywords": ["weixin", "wechat", "clawbot", "ilink", "shell", "cli"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": { "node": ">=22.9" },
  "scripts": {
    "login": "node src/cli.js login",
    "start": "node src/cli.js start",
    "test": "node --test",
    "check": "node --check src/cli.js && node --check src/ilink.js && node --check src/login.js && node --check src/bridge.js && node --check src/runner.js && node --check src/state.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": { "qrcode-terminal": "^0.12.0" }
}
