# 执行命令的固定工作目录；省略时使用启动服务时的当前目录。
# WEIXIN_CWD=/Users/yourname/projects

# 凭证、消息游标、执行记录所在目录；默认 ~/.weixin-shell。
# WEIXIN_STATE_DIR=/Users/yourname/.weixin-shell

# 单条命令超时，单位毫秒。
WEIXIN_TIMEOUT_MS=60000

# stdout 与 stderr 的总字节上限，超过时终止命令。
WEIXIN_MAX_OUTPUT_BYTES=24000

# 默认使用非交互 Shell；PATH 等环境继承启动服务的终端。
WEIXIN_SHELL=/bin/sh

# Shell 启动参数，JSON 字符串数组；命令正文作为最后一个参数原样追加。
WEIXIN_SHELL_ARGS='["-c"]'
# 若要加载 ~/.zshrc 中的别名，同时设置下面两项：
# WEIXIN_SHELL=/bin/zsh
# WEIXIN_SHELL_ARGS='["-i","-c"]'

# iLink 协议兼容版本，前三段为微信插件协议版本，不是本项目版本。
WEIXIN_PROTOCOL_VERSION=3.0.1/weixin-shell-0.1.0
